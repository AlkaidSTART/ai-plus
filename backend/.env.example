# InsightX backend environment example. Copy to .env and fill in real values.
# NEVER commit real secrets.

# [App]
APP_ENV=dev
# APP_VERSION is defined in code; no env override needed normally.

# [Database & Cache]
DATABASE_URL=postgresql+asyncpg://insightx:CHANGE_ME@localhost:5432/insightx
REDIS_URL=redis://localhost:6379/0
DB_ECHO=false

# CORS: comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:5173

# SSE
SSE_HEARTBEAT_SECONDS=15

# [AI Models] (Step 3, optional in dev)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# [Amazon data provider] (Step 3). Empty = provider not configured.
AMAZON_API_BASE_URL=
AMAZON_API_KEY=

# [Embedding]
EMBEDDING_DEVICE=cpu

# [Provider mode] deterministic = 离线确定性 Provider；real = 正式 Service/Provider
# real 模式下未配置 AMAZON_API_BASE_URL 时回退 FakeAmazonDataProvider（演示数据）
PROVIDER_MODE=deterministic
REVIEW_CACHE_TTL_HOURS=24
