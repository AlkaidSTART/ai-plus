# InsightX 前端环境变量示例
# 复制为 .env.development / .env.production 后按需修改

# 是否使用内置 mock 数据（true 时无需后端即可完整演示全部页面）
# 后端就绪后置为 false，即可切到真实 REST + SSE
VITE_USE_MOCK=true

# 后端 API 根地址（不含 /api/v1 前缀之外的路径，接口文档 Base URL 为 <此值>）
#  - 独立部署 SPA：EventSource 与 fetch 均直连此地址（生产）
#  - 开发环境留空（/api/v1）时，请求走 vite 代理 → http://localhost:8000
VITE_API_BASE_URL=/api/v1

# 生产示例（直连后端，SSE 同址直连）：
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=https://api.insightx.example.com/api/v1
