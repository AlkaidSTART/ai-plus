---
/**
 * FeatureCard —— 静态功能卡片（Astro 组件，零 JS）
 */
interface Props {
  icon: string
  title: string
  desc: string
  tags: string[]
}
const { icon, title, desc, tags } = Astro.props
---

<div class="card">
  <div class="icon" aria-hidden="true" innerHTML={icon} />
  <h3>{title}</h3>
  <p>{desc}</p>
  <ul class="tags">
    {tags.map((t) => <li>{t}</li>)}
  </ul>
</div>

<style>
  .card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -24px rgb(2 6 23 / 0.2);
  }
  .icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: #eff6ff;
    color: #2563eb;
    margin-bottom: 14px;
  }
  h3 {
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px;
  }
  p {
    font-size: 14px;
    line-height: 1.7;
    color: #475569;
    margin: 0 0 14px;
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    font-size: 12px;
    color: #0e7490;
    background: #ecfeff;
    border-radius: 9999px;
    padding: 3px 10px;
  }
</style>
